*.vhd
*.vdi
*.vmdk
*.qcow2
.tmp/

# Isletim sistemi artiklari
System Volume Information/
.DS_Store
Thumbs.db
desktop.ini

# Claude oturum kayitlari (proje icinde durur).
#   .claude/sessions/<slug>/*.jsonl  CANLI transcript'ler. session-persistence
#       skill'i ~/.claude/projects/<slug> klasorunu buraya tasiyip yerine junction
#       birakir. Bunlar DEPOYA GIRER: gecmis boylece makineler arasi tasinir ve
#       cleanupPeriodDays'ten bagimsiz kalici olur. Depo private olmalidir --
#       transcript konusmanin tamamidir (parola, token, ic bilgi).
#   .claude/sessions/*.jsonl         SessionEnd kancasinin ust dizine biraktigi
#       ARSIV KOPYALARI. Ayni veri ikinci kez depoya girmesin diye yok sayilir.
# DIKKAT: asagidaki desen tek yildizlidir ve alt dizinleri KAPSAMAZ. `**` yapmayin;
# yoksa canli transcript'ler de depodan duser ve kalicilik ortadan kalkar.
.claude/settings.local.json
.claude/sessions/*.jsonl

# Uygulamanin calisma zamani gunlugu (main_window.log -> paths.LOG_DIR).
# Belge dokumleri (.claude/logs/*.md) depoda kalir, gunluk dosyalari kalmaz.
.claude/logs/*.log

# Tanilama ciktilari: oturum gunlukleri ve donma raporlari makineye ozeldir.
# Bir donma raporunu saklamak gerekirse .claude/logs/ altina tasinir.
.claude/logs/runtime/
.claude/logs/freeze/

# PyInstaller paketleme ciktilari (build_exe.bat / DiskUltimate.spec)
build/
dist/
