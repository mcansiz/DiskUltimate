#!/bin/sh
# DiskUltimate live tabani: chroot icinde son ayarlar (ADR 0101).
set -e
chmod 755 /usr/local/bin/diskultimate /usr/local/lib/diskultimate/session \
  /usr/local/lib/diskultimate/netstatus /usr/local/lib/diskultimate/run-launcher \
  /usr/local/lib/diskultimate/ci-checks
chmod 755 /root/Desktop/*.desktop
# Ag: NetworkManager (kablolu + kablosuz). Acilisi beklemesin: ag bekleyen
# bir servis yok, kablo takili degilse wait-online 90 sn bosuna oyalar.
systemctl enable NetworkManager.service
systemctl disable NetworkManager-wait-online.service 2>/dev/null || true
# Gunluk apt isleri live oturumda yalnizca kilit tutar: kullanicinin
# `apt update`'i "Could not get lock" ile duserdi.
systemctl mask apt-daily.timer apt-daily-upgrade.timer
# .desktop -> "Calistir" kaydi (run-launcher). GIO dosyalari kendisi de
# tarar; desktop-file-utils kuruluysa onbellek de yazilir.
update-desktop-database -q /usr/share/applications 2>/dev/null || true
# Uygulama katmani buraya baglanir (zz-diskultimate.squashfs); taban bos tutar.
mkdir -p /opt/diskultimate
# Masaustu yoneticisi yok: grafik oturumu tty1 otomatik girisi baslatir.
systemctl set-default multi-user.target

# Ilk asamada (debootstrap, live-build hazirligi) kurulan paketler dpkg kirpma
# kuralindan (includes.chroot_before_packages) ONCE geldi; onlarin belge, man
# ve dil dosyalari burada silinir. Ilk derlemede ~48 MB dil dosyasi kalmisti.
find /usr/share/doc -mindepth 2 ! -type d ! -name copyright -delete
find /usr/share/doc -mindepth 1 -type d -empty -delete
rm -rf /usr/share/man/* /usr/share/info/* /usr/share/lintian/*
for d in /usr/share/locale/*/; do
  case "$(basename "$d")" in
    tr|en|en_*|de|fr|it|es|ru|zh_CN|ja|ko) ;;
    *) rm -rf "$d" ;;
  esac
done
