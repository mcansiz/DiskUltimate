# DiskUltimate live: kablolu aga kendiliginden baglanma (ADR 0101).
#
# Tabanda ifupdown + dhcpcd-base kurulu ama hicbiri calismiyordu:
# /etc/network/interfaces arabirim tanimlamiyor (live-boot yalnizca ag
# acilisinda yazar), dhcpcd-base servis dosyasi getirmez. Sonuc: IP yok,
# /etc/resolv.conf bos, `apt update` "gecici cozumleme hatasi" veriyordu.
#
# dhcpcd ana kipte (arabirim adi verilmeden) tum arabirimleri yonetir, kablo
# sonradan takilinca da adres alir ve DNS'i /etc/resolv.conf'a kendisi yazar
# (dhcpcd-hooks/20-resolv.conf). Ek paket gerekmez.
[Unit]
Description=DiskUltimate live: DHCP on all interfaces (dhcpcd)
Wants=network.target
Before=network.target
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/sbin/dhcpcd -B -q
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
