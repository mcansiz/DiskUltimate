#!/bin/sh
# Gorev cubugunda ag durumu (ADR 0101).
#
# jwm'in <Swallow name="dunet"> ogesine gomulen tek satirlik xterm'de calisir;
# durum degisince satiri yeniden yazar. jwm'de degisen metin gosteren bir
# tepsi ogesi yok. Ag secimi (kablosuz) yanindaki nm-applet simgesindendir;
# bu satir yalnizca o anki baglantiyi yazi olarak gosterir.
#
#   netstatus        gorev cubugu dongusu
#   netstatus --ip   fiziksel bir arabirimin IPv4 adresi (oturum denemesi, CI)
. /usr/local/lib/diskultimate/env.sh

# Fiziksel arabirimler: "eth <ad>" ya da "wifi <ad>". lo ve sanal
# arabirimlerin `device` baglantisi yok; kablosuzlarin `wireless` dizini var.
devices() {
  for d in /sys/class/net/*; do
    [ -e "$d/device" ] || continue
    if [ -d "$d/wireless" ]; then echo "wifi ${d##*/}"; else echo "eth ${d##*/}"; fi
  done
}

ipv4() {
  ip -4 -o addr show dev "$1" scope global 2>/dev/null \
    | sed -n 's/.* inet \([0-9.]*\).*/\1/p' | head -n1
}

# Kablosuz baglantinin adi (NM baglanti adi = ag adi, SSID). Uzun ad
# kesilmez: xterm satiri 26 sutunda kendisi kirpar (cut baytla keser,
# UTF-8 harfi bolerdi). Ters bolu printf %b'ye kacis olarak gitmesin.
ssid() {
  nmcli -g GENERAL.CONNECTION device show "$1" 2>/dev/null | head -n1 | tr -d '\\'
}

if [ "${1:-}" = "--ip" ]; then
  for n in $(devices | cut -d' ' -f2); do
    a="$(ipv4 "$n")"
    [ -n "$a" ] && { echo "$a"; exit 0; }
  done
  exit 1
fi

case "$DU_LANG" in
  tr) T_NONE="Ağ kartı yok";          T_CABLE="Kablo takılı değil";  T_WAIT="Bağlanıyor…";      T_DISC="Bağlı değil" ;;
  de) T_NONE="Kein Netzwerkadapter";  T_CABLE="Kein Kabel";          T_WAIT="Verbinde…";        T_DISC="Nicht verbunden" ;;
  fr) T_NONE="Aucune carte réseau";   T_CABLE="Câble débranché";     T_WAIT="Connexion…";       T_DISC="Non connecté" ;;
  it) T_NONE="Nessuna scheda di rete"; T_CABLE="Cavo scollegato";    T_WAIT="Connessione…";     T_DISC="Non connesso" ;;
  es) T_NONE="Sin tarjeta de red";    T_CABLE="Cable desconectado";  T_WAIT="Conectando…";      T_DISC="Sin conexión" ;;
  ru) T_NONE="Нет сетевой карты";     T_CABLE="Кабель не подключён"; T_WAIT="Подключение…";     T_DISC="Не подключено" ;;
  zh) T_NONE="无网卡";                T_CABLE="网线未连接";          T_WAIT="正在连接…";        T_DISC="未连接" ;;
  ja) T_NONE="アダプターなし";        T_CABLE="ケーブル未接続";      T_WAIT="接続中…";          T_DISC="未接続" ;;
  ko) T_NONE="네트워크 카드 없음";    T_CABLE="케이블 연결 안 됨";   T_WAIT="연결 중…";         T_DISC="연결 안 됨" ;;
  *)  T_NONE="No network adapter";    T_CABLE="Cable unplugged";     T_WAIT="Connecting…";      T_DISC="Not connected" ;;
esac

# eth <ip> | wifi <ag adi> | wait (baglanti var, adres yok) |
# disc (kablosuz kart var, bagli degil) | cable (yalnizca kablolu, kablo yok) |
# none (kart yok)
state() {
  st=none
  set -- $(devices)
  while [ $# -ge 2 ]; do
    kind=$1; n=$2; shift 2
    a="$(ipv4 "$n")"
    if [ -n "$a" ]; then
      if [ "$kind" = wifi ]; then echo "wifi $(ssid "$n")"; else echo "eth $a"; fi
      return
    fi
    if [ "$(cat "/sys/class/net/$n/carrier" 2>/dev/null)" = 1 ]; then
      st=wait
    elif [ "$kind" = wifi ] && [ "$st" != wait ]; then
      st=disc
    elif [ "$st" = none ]; then
      st=cable
    fi
  done
  echo "$st"
}

printf '\033[?25l'                       # imlec gizli
last=""
while :; do
  s="$(state)"
  if [ "$s" != "$last" ]; then
    last="$s"
    case "$s" in
      eth*)  line="\033[32m●\033[0m Ethernet ${s#eth }" ;;
      wifi*) line="\033[32m●\033[0m Wi-Fi ${s#wifi }" ;;
      wait)  line="\033[33m●\033[0m $T_WAIT" ;;
      disc)  line="\033[90m●\033[0m $T_DISC" ;;
      cable) line="\033[31m●\033[0m $T_CABLE" ;;
      *)     line="\033[90m●\033[0m $T_NONE" ;;
    esac
    printf '\033[H\033[2J%b' "$line"
  fi
  sleep 3
done
