#!/bin/sh
# Gorev cubugunda ag durumu (ADR 0101).
#
# jwm'in <Swallow name="dunet"> ogesine gomulen tek satirlik xterm'de calisir;
# durum degisince satiri yeniden yazar. jwm'de degisen metin gosteren bir
# tepsi ogesi yok; NetworkManager + nm-applet ise tabana onlarca MB ekler.
#
#   netstatus        gorev cubugu dongusu
#   netstatus --ip   kablolu arabirimin IPv4 adresi (oturum denemesi, CI)
. /usr/local/lib/diskultimate/env.sh

# Fiziksel kablolu arabirimler: lo ve sanal arabirimlerin `device`
# baglantisi yok, kablosuzlarin `wireless` dizini var.
wired() {
  for d in /sys/class/net/*; do
    [ -e "$d/device" ] && [ ! -d "$d/wireless" ] && echo "${d##*/}"
  done
}

ipv4() {
  ip -4 -o addr show dev "$1" scope global 2>/dev/null \
    | sed -n 's/.* inet \([0-9.]*\).*/\1/p' | head -n1
}

if [ "${1:-}" = "--ip" ]; then
  for n in $(wired); do
    a="$(ipv4 "$n")"
    [ -n "$a" ] && { echo "$a"; exit 0; }
  done
  exit 1
fi

case "$DU_LANG" in
  tr) T_NONE="Ethernet kartı yok"; T_CABLE="Kablo takılı değil";    T_WAIT="Adres alınıyor…" ;;
  de) T_NONE="Kein Ethernet-Adapter"; T_CABLE="Kein Kabel";            T_WAIT="Adresse wird bezogen…" ;;
  fr) T_NONE="Pas de carte Ethernet"; T_CABLE="Câble débranché";      T_WAIT="Obtention d'adresse…" ;;
  it) T_NONE="Nessuna scheda Ethernet"; T_CABLE="Cavo scollegato";   T_WAIT="Richiesta indirizzo…" ;;
  es) T_NONE="Sin tarjeta Ethernet"; T_CABLE="Cable desconectado";    T_WAIT="Obteniendo dirección…" ;;
  ru) T_NONE="Нет Ethernet-адаптера"; T_CABLE="Кабель не подключён";   T_WAIT="Получение адреса…" ;;
  zh) T_NONE="无以太网卡";          T_CABLE="网线未连接";            T_WAIT="正在获取地址…" ;;
  ja) T_NONE="イーサネットなし";   T_CABLE="ケーブル未接続";        T_WAIT="アドレス取得中…" ;;
  ko) T_NONE="이더넷 어댑터 없음"; T_CABLE="케이블 연결 안 됨";     T_WAIT="주소 받는 중…" ;;
  *)  T_NONE="No Ethernet adapter"; T_CABLE="Cable unplugged";       T_WAIT="Getting address…" ;;
esac

# up <ip> | wait (kablo var, adres yok) | cable (kablo yok) | none (kart yok)
state() {
  st=none
  for n in $(wired); do
    a="$(ipv4 "$n")"
    if [ -n "$a" ]; then
      echo "up $a"
      return
    fi
    if [ "$(cat "/sys/class/net/$n/carrier" 2>/dev/null)" = 1 ]; then
      st=wait
    elif [ "$st" = none ]; then
      st=cable
    fi
  done
  echo "$st"
}

printf '\033[?25l'                       # imlec gizli
last=""
while :; do
  s="$(state)"
  if [ "$s" != "$last" ]; then
    last="$s"
    case "$s" in
      up*)   line="\033[32m●\033[0m Ethernet ${s#up }" ;;
      wait)  line="\033[33m●\033[0m $T_WAIT" ;;
      cable) line="\033[31m●\033[0m $T_CABLE" ;;
      *)     line="\033[90m●\033[0m $T_NONE" ;;
    esac
    printf '\033[H\033[2J%b' "$line"
  fi
  sleep 3
done
