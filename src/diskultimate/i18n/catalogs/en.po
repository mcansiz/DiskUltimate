#: src/diskultimate/ui/main_window.py:3997
msgid ""
"<h3>{} {}</h3><p>Disk goruntusu, sanal disk ve <b>sistemdeki gercek "
"diskler</b> uzerinde bolumleme, bicimlendirme, yedekleme ve kurtarma "
"araci.</p><p><b>Teknoloji:</b> Python 3 + PyQt5, harici bagimlilik "
"yok<br><b>Bolum tablolari:</b> MBR (mantiksal bolumler dahil), GPT, "
"MBR&nbsp;&harr;&nbsp;GPT donusumu<br><b>Bicimlendirme:</b> FAT12/16/32, "
"exFAT, ext2/3/4 ve NTFS — sekizi de saf Python, uc platformda<br><b>Dosya "
"erisimi:</b> FAT ve exFAT tam okuma/yazma</p><p>Goruntu dosyalari yonetici "
"yetkisi gerektirmez. Fiziksel disk erisimi yonetici/root ister ve "
"<b>varsayilan olarak salt okunurdur</b>; yazma ayrica onay ister.</p>"
msgstr ""
"<h3>{} {}</h3><p>A tool for partitioning, formatting, backing up and "
"recovering disk images, virtual disks and <b>real disks on this "
"system</b>.</p><p><b>Technology:</b> Python 3 + PyQt5, no external "
"dependencies<br><b>Partition tables:</b> MBR (including logical "
"partitions), GPT, MBR&nbsp;&harr;&nbsp;GPT "
"conversion<br><b>Formatting:</b> FAT12/16/32, exFAT, ext2/3/4 and NTFS — "
"all eight in pure Python, on three platforms<br><b>File access:</b> full "
"read/write for FAT and exFAT</p><p>Image files do not require "
"administrator privileges. Physical disk access requires administrator/root "
"and is <b>read-only by default</b>; writing asks for separate "
"confirmation.</p>"

#: src/diskultimate/ui/main_window.py:755
msgid ""
"<p>Bu uygulama asagidaki ikon paketlerinden secilmis ikonlari gomulu "
"olarak icerir. Isletim sistemi amblemleri sahiplerinin ticari markasidir; "
"yalnizca diski tanitmak icin gosterilir.</p>"
msgstr ""
"<p>This application embeds selected icons from the following icon packs. "
"Operating system emblems are trademarks of their owners and are shown only "
"to identify the disk.</p>"

#: src/diskultimate/ui/dialogs/tools.py:74
msgid ""
"<span style='color:#b23c17'><b>Uyari:</b> Bu islem geri alinamaz. Silinen "
"veriler kurtarilamaz.</span>"
msgstr ""
"<span style='color:#b23c17'><b>Warning:</b> This operation cannot be "
"undone. Erased data cannot be recovered.</span>"

#: src/diskultimate/ui/dialogs/ntfsfix.py:79
msgid ""
"<span style='color:#b23c17'><b>Uyari:</b> Windows'un diske henuz "
"islemedigi son degisiklikler kaybolabilir. Mumkunse Windows'u acip "
"<b>Yeniden baslat</b> ile kapatmak ve Hizli baslatmayi kapatmak daha "
"guvenlidir. Onarimdan sonra Windows'ta chkdsk onerilir.</span>"
msgstr ""
"<span style='color:#b23c17'><b>Warning:</b> the last changes Windows has "
"not yet written to disk may be lost. If possible, it is safer to start "
"Windows, shut it down with <b>Restart</b> and turn off Fast Startup. "
"Running chkdsk on Windows after the repair is recommended.</span>"

#: src/diskultimate/ui/dialogs/partition.py:228
msgid ""
"<span style='color:#b23c17'>Uyari: bolumdeki tum veriler silinir.</span>"
