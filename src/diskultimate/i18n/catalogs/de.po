#: src/diskultimate/ui/dialogs/bootloader.py:246
msgid "<b>{}</b> ({}) — {}"
msgstr "<b>{}</b> ({}) — {}"

#: src/diskultimate/ui/main_window.py:795
msgid ""
"<b>{}</b> bir DiskUltimate yedegidir. Icerigi <b>salt okunur</b> olarak "
"gezebilirsiniz: bolumler, klasorler ve dosyalar gorunur, dosyalari disa "
"aktarabilirsiniz.<br><br><b>Kaynak boyut:</b> {}<br><b>Yedek boyut:</b> "
"{}<br><b>Olusturma:</b> {}<br><br>Yedegi bir <b>diske veya goruntuye "
"yazmak</b> icin: <i>Disk &gt; Yedegi diske yaz...</i>"
msgstr ""
"<b>{}</b> ist eine DiskUltimate-Sicherung. Sie können den Inhalt "
"<b>schreibgeschützt</b> durchsuchen: Partitionen, Ordner und Dateien sind "
"sichtbar und Dateien können exportiert werden.<br><br><b>Quellgröße:</b> "
"{}<br><b>Sicherungsgröße:</b> {}<br><b>Erstellt:</b> {}<br><br>Um die "
"<b>Sicherung auf einen Datenträger oder in ein Abbild zu schreiben</b>: "
"<i>Datenträger &gt; Sicherung auf Datenträger schreiben...</i>"

#: src/diskultimate/ui/dialogs/bootloader.py:275
msgid ""
"<b>{}</b> diskindeki onyukleme kodu ({}) kaldirilacak.<br><br>Bolum "
"tablosu ve dosyalar <b>korunur</b>; ama bu diskten acilan sistem artik "
"acilmaz.<br><br>Islem hemen yapilmaz: bekleyen islemlere eklenir ve "
"\"Uygula\" dediginizde calisir."
msgstr ""
"Der Startcode ({}) auf Datenträger <b>{}</b> wird "
"entfernt.<br><br>Partitionstabelle und Dateien bleiben <b>erhalten</b>; "
"das von diesem Datenträger gestartete System startet jedoch nicht "
"mehr.<br><br>Es geschieht noch nichts: Der Schritt wird den ausstehenden "
"Vorgängen hinzugefügt und bei \"Anwenden\" ausgeführt."

#: src/diskultimate/ui/dialogs/tools.py:281
msgid "<b>{}</b> dosya imzasi bulundu."
msgstr "<b>{}</b> Dateisignaturen gefunden."

#: src/diskultimate/ui/main_window.py:3114
msgid ""
"<b>{}</b> salt okunur acik — bu <b>normaldir</b>.<br><br>Yaptiginiz "
"degisiklikler bekleyen islem olarak birikir ve diske ancak <b>Uygula</b> "
"dediginizde yazilir."
msgstr ""
"<b>{}</b> ist schreibgeschützt geöffnet — das ist "
"<b>normal</b>.<br><br>Ihre Änderungen werden als ausstehende Vorgänge "
"gesammelt und erst dann auf den Datenträger geschrieben, wenn Sie "
"<b>Anwenden</b> wählen."

#: src/diskultimate/ui/main_window.py:3083
msgid ""
"<b>{}</b> salt okunur acildi; bu dosyada degisiklik "
"yapilamaz.<br><br><b>Neden:</b> {}<br><b>Yol:</b> {}<br><b>Bicim:</b> {}"
msgstr ""
"<b>{}</b> wurde schreibgeschützt geöffnet; diese Datei kann nicht geändert "
"werden.<br><br><b>Grund:</b> {}<br><b>Pfad:</b> {}<br><b>Format:</b> {}"

#: src/diskultimate/ui/dialogs/tools.py:119
