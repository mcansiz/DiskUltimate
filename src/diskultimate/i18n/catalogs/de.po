msgid "<b>{}</b> — {} (ilk {} gosteriliyor)"
msgstr "<b>{}</b> — {} (die ersten {} werden angezeigt)"

#: src/diskultimate/ui/main_window.py:867
msgid ""
"<b>{}</b><br>{}<br><br><b>Durum:</b> {}<br><br>Yedek: {} ({})<br><br>Bu "
"diskteki <b>tum veriler silinecek</b> ve yedek icerigi yazilacak. Islem "
"<b>geri alinamaz</b>.<br><br>Devam edilsin mi?"
msgstr ""
"<b>{}</b><br>{}<br><br><b>Status:</b> {}<br><br>Sicherung: {} "
"({})<br><br><b>Alle Daten</b> auf diesem Datenträger werden gelöscht und "
"der Inhalt der Sicherung geschrieben. Dieser Vorgang <b>kann nicht "
"rückgängig gemacht werden</b>.<br><br>Fortfahren?"

#: src/diskultimate/ui/main_window.py:1942
msgid ""
"<br><br><b>{} adim veri kaybettirebilir.</b> Uygulandiktan sonra geri "
"alinamaz."
msgstr ""
"<br><br><b>{} Schritte können Datenverlust verursachen.</b> Nach dem "
"Anwenden lassen sie sich nicht rückgängig machen."

#: src/diskultimate/ui/main_window.py:3088
msgid ""
"<br><br>Dosyayi kullanan diger programi (baska bir disk araci, yedekleme "
"yazilimi vb.) kapatip <b>Yeniden dene</b>ye basin."
msgstr ""
"<br><br>Schließen Sie das andere Programm, das die Datei benutzt (ein "
"anderes Datenträgerwerkzeug, eine Sicherungssoftware usw.), und drucken "
"Sie <b>Erneut versuchen</b>."

#: src/diskultimate/ui/main_window.py:3190
msgid ""
"<h3>{} {}</h3><p>Disk goruntusu, sanal disk ve <b>sistemdeki gercek "
"diskler</b> uzerinde bolumleme, bicimlendirme, yedekleme ve kurtarma "
"araci.</p><p><b>Teknoloji:</b> Python 3 + PyQt5, harici bagimlilik "
"yok<br><b>Bolum tablolari:</b> MBR (mantiksal bolumler dahil), GPT, "
"MBR&nbsp;&harr;&nbsp;GPT donusumu<br><b>Bicimlendirme:</b> FAT12/16/32, "
"exFAT, ext2/3/4 ve NTFS — sekizi de saf Python, uc platformda<br><b>Dosya "
"erisimi:</b> FAT ve exFAT tam okuma/yazma</p><p>Goruntu dosyalari yonetici "
"yetkisi gerektirmez. Fiziksel disk erisimi yonetici/root ister ve "
"<b>varsayilan olarak salt okunurdur</b>; yazma ayrica onay ister.</p>"
msgstr ""
"<h3>{} {}</h3><p>Ein Werkzeug zum Partitionieren, Formatieren, Sichern und "
"Wiederherstellen von Abbildern, virtuellen Datenträgern und <b>echten "
"Datenträgern dieses Systems</b>.</p><p><b>Technik:</b> Python 3 + PyQt5, "
"keine externen Abhängigkeiten<br><b>Partitionstabellen:</b> MBR "
"(einschließlich logischer Partitionen), GPT, Umwandlung "
"MBR&nbsp;&harr;&nbsp;GPT<br><b>Formatieren:</b> FAT12/16/32, exFAT, "
"ext2/3/4 und NTFS — alle acht in reinem Python, auf drei "
"Plattformen<br><b>Dateizugriff:</b> volles Lesen/Schreiben für FAT und "
"exFAT</p><p>Abbilddateien brauchen keine Administratorrechte. Der Zugriff "
"auf physische Datenträger verlangt Administrator/root und ist "
"<b>standardmäßig schreibgeschützt</b>; das Schreiben wird gesondert "
"bestätigt.</p>"

#: src/diskultimate/ui/dialogs/tools.py:74
msgid ""
"<span style='color:#b23c17'><b>Uyari:</b> Bu islem geri alinamaz. Silinen "
"veriler kurtarilamaz.</span>"
msgstr ""
"<span style='color:#b23c17'><b>Warnung:</b> Dieser Vorgang kann nicht "
"rückgängig gemacht werden. Gelöschte Daten sind nicht "
"wiederherstellbar.</span>"

#: src/diskultimate/ui/dialogs/partition.py:227
