{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/archive-session.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/archive-session.py\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Oturum dokumu .claude/sessions/ altina arsivleniyor"
          }
        ]
      }
    ]
  },
  "cleanupPeriodDays": 36500,
  "env": {
    "ARCHIFY_UPDATE_CACHE_DIRECTORY": ".claude/cache/archify"
  }
}
